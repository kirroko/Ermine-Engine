# Default Texture Compiler Settings
[Compiler]
Type=PNG_TO_DDS
Version=1.0

[Settings]
# Compression format for textures
CompressionFormat=BC3_UNORM
# Generate mipmaps
GenerateMipmaps=true
# Maximum texture size
MaxTextureSize=2048
# Quality settings (0-100)
CompressionQuality=85

[Output]
# Output file extension
OutputExtension=.dds
# Preserve alpha channel
PreserveAlpha=true

[Filters]
# Only process PNG files
InputExtensions=.png,.PNG

[Debug]
# Enable verbose logging
VerboseLogging=true
# Keep intermediate files for debugging
KeepIntermediateFiles=false